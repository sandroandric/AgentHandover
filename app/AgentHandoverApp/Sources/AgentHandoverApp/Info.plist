<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>AgentHandover</string>
    <key>CFBundleExecutable</key>
    <string>AgentHandover</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleName</key>
    <string>AgentHandover</string>
    <key>CFBundleIdentifier</key>
    <string>com.agenthandover.app</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>2.0.3</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.3</string>
    <!-- Must match Package.swift platforms and the cask depends_on. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- LSUIElement=true makes this a menu-bar-only (accessory) app.
         REQUIRED for SwiftUI MenuBarExtra to register a status bar
         item correctly.  Without it, the app launches as a regular
         Dock app and the menu bar icon silently fails to appear.
         Bug caught 2026-04-10 — affected all v0.2.0 users. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Shown when macOS asks, per app, to let AgentHandover read its
         open document ([privacy] read_app_state, opt-in in onboarding). -->
    <key>NSAppleEventsUsageDescription</key>
    <string>AgentHandover reads the name of the open document, page or message to understand your workflow. It never acts in the app.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2026 Sandro Andric. Apache 2.0 License.</string>
    <key>SUPublicEDKey</key>
    <string>/0p0TTgbLloxiQqGwRSm2rw7PCKE+E5y3EJZkKGzYi4=</string>
    <key>SUFeedURL</key>
    <string>https://www.agenthandover.com/appcast.xml</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
