#!/bin/bash
# AgentHandover pre-install script: stops the running app and services
# before the payload replaces them.
#
# Honours the same AH_* overrides as postinstall (see there) so the install
# test harness can run it unprivileged against a temporary prefix.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=resolve-user.sh
. "${SCRIPT_DIR}/resolve-user.sh"
ah_resolve_user || exit 1

LIB_DIR="${AH_LIB_DIR:-/usr/local/lib/agenthandover}"
LAUNCH_AGENTS="${AH_LAUNCH_AGENTS:-${USER_HOME}/Library/LaunchAgents}"
APP_PATH="${AH_APP_PATH:-/Applications/AgentHandover.app}"
NO_SERVICES="${AH_NO_SERVICES:-0}"

# Quit the menu bar app so the payload does not land under a live process
# and postinstall's `open` starts the new binary instead of re-attaching to
# the old one. Ask politely first (the app stops the daemon it spawned on
# quit), then wait up to 5 s, then kill whatever is left. The `is running`
# guard matters: a bare `tell application` would launch the app to quit it.
as_user /usr/bin/osascript \
    -e 'if application id "com.agenthandover.app" is running then' \
    -e 'tell application id "com.agenthandover.app" to quit' \
    -e 'end if' >/dev/null 2>&1 || true
for _ in 1 2 3 4 5; do
    pgrep -x -u "${CONSOLE_UID}" AgentHandover >/dev/null || break
    sleep 1
done
pkill -x -u "${CONSOLE_UID}" AgentHandover 2>/dev/null || true

if [ "${NO_SERVICES}" != "1" ]; then
    # Stop the daemon launchd job left by pre-v0.2.1 installs (the daemon
    # is app-launched now) and the worker, using bootout (the deprecated
    # `launchctl unload` is broken on macOS 13+).
    as_user launchctl bootout "gui/${CONSOLE_UID}/com.agenthandover.daemon" 2>/dev/null || true
    as_user launchctl disable "gui/${CONSOLE_UID}/com.agenthandover.daemon" 2>/dev/null || true
    as_user launchctl bootout "gui/${CONSOLE_UID}/com.agenthandover.worker" 2>/dev/null || true
    as_user launchctl bootout "gui/${CONSOLE_UID}/com.openmimic.daemon" 2>/dev/null || true
    as_user launchctl bootout "gui/${CONSOLE_UID}/com.openmimic.worker" 2>/dev/null || true

    # Kill any daemon the app did not stop.
    killall ah-observer 2>/dev/null || true

    rm -f /Library/LaunchAgents/com.agenthandover.daemon.plist 2>/dev/null
    rm -f /Library/LaunchDaemons/com.agenthandover.daemon.plist 2>/dev/null
fi

# Remove the stale daemon launchd plist. Prior to v0.2.1 the build shipped
# a com.agenthandover.daemon.plist pointing into the app bundle; the pkg
# installer only replaces files in the new Bom, so it survives an upgrade
# unless deleted explicitly. See issue #1.
rm -f "${LAUNCH_AGENTS}/com.agenthandover.daemon.plist" 2>/dev/null
rm -f "${LIB_DIR}/launchd/com.agenthandover.daemon.plist" 2>/dev/null
rm -f "${LAUNCH_AGENTS}/com.openmimic.daemon.plist" 2>/dev/null
rm -f "${LAUNCH_AGENTS}/com.openmimic.worker.plist" 2>/dev/null

# Remove the old daemon from inside the app bundle (moved to LIB_DIR).
# Inside the bundle, codesign --deep registered it as a second TCC principal.
rm -rf "${APP_PATH}/Contents/Helpers/AgentHandoverDaemon.app" 2>/dev/null || true
rm -f "${APP_PATH}/Contents/Helpers/ah-observer" 2>/dev/null || true

# Remove Chromium-family native host manifests until the app reaches
# extension setup. Any stale manifest can respawn ah-observer during
# onboarding and surface it as the Screen Recording principal.
for browser_dir in \
    "Google/Chrome" \
    "Chromium" \
    "BraveSoftware/Brave-Browser" \
    "Microsoft Edge" \
    "Arc/User Data" \
    "Comet"; do
    rm -f "${USER_HOME}/Library/Application Support/${browser_dir}/NativeMessagingHosts/com.agenthandover.host.json" 2>/dev/null || true
done

echo "Pre-install complete."
exit 0
