#!/bin/bash
# AgentHandover post-install script
set -e

# Non-fatal warnings: reported at the end, do not abort the install.
WARNINGS=""
warn() { WARNINGS="${WARNINGS}\n  ! $1"; }

# Install locations. The defaults are the real install; the AH_* overrides
# let a developer or the install test harness (tests/install/) run this
# script unprivileged into a temporary prefix. AH_NO_SERVICES=1 skips
# everything that touches the live login session (launchctl, tccutil,
# defaults, opening the app) so a test install cannot disturb a real one.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=resolve-user.sh
. "${SCRIPT_DIR}/resolve-user.sh"
ah_resolve_user || exit 1

LIB_DIR="${AH_LIB_DIR:-/usr/local/lib/agenthandover}"
BIN_DIR="${AH_BIN_DIR:-/usr/local/bin}"
LAUNCH_AGENTS="${AH_LAUNCH_AGENTS:-${USER_HOME}/Library/LaunchAgents}"
APP_PATH="${AH_APP_PATH:-/Applications/AgentHandover.app}"
NO_SERVICES="${AH_NO_SERVICES:-0}"
IS_ROOT=0
if [ "$(id -u)" -eq 0 ]; then IS_ROOT=1; fi

echo "  Installing for user: ${CONSOLE_USER} (UID=${CONSOLE_UID}, HOME=${USER_HOME}, detected via ${DETECT_METHOD})"
DATA_DIR="${USER_HOME}/Library/Application Support/agenthandover"
LOG_DIR="${DATA_DIR}/logs"
PIP_LOG="${LOG_DIR}/pip-install.log"
VENV="${LIB_DIR}/venv"

# Fresh install vs upgrade. The marker is written at the end of every
# completed install, so its absence means no install has finished here.
IS_FRESH=0
if [ ! -f "${DATA_DIR}/config.toml.bak" ]; then IS_FRESH=1; fi

# Create data directories (owned by the user, not root)
mkdir -p "${LOG_DIR}"
mkdir -p "${DATA_DIR}/artifacts"
touch "${PIP_LOG}"
chown -R "${CONSOLE_USER}" "${DATA_DIR}"

# Write the worker LaunchAgent with the user's log paths and this install's
# lib dir (a static plist cannot know either).
# The daemon is launched by the menu bar app (not launchd); only the worker
# uses launchd.
mkdir -p "${LAUNCH_AGENTS}"
cp "${LIB_DIR}/launchd/com.agenthandover.worker.plist" "${LAUNCH_AGENTS}/"
sed -i '' \
    -e "s|__AH_LOG_DIR__|${LOG_DIR}|g" \
    -e "s|/usr/local/lib/agenthandover|${LIB_DIR}|g" \
    "${LAUNCH_AGENTS}/com.agenthandover.worker.plist"
chown "${CONSOLE_USER}" "${LAUNCH_AGENTS}/com.agenthandover.worker.plist"

# Create default config if none exists
if [ ! -f "${DATA_DIR}/config.toml" ]; then
    cat > "${DATA_DIR}/config.toml" << 'TOML'
# AgentHandover Configuration
# See https://github.com/sandroandric/AgentHandover for documentation

[observer]
t_dwell_seconds = 3
t_scroll_read_seconds = 8
capture_screenshots = true
screenshot_max_per_minute = 20

[privacy]
enable_inline_secret_redaction = true
secure_field_drop = true

[storage]
retention_days_raw = 14
retention_days_episodes = 90

[export]
adapter = "all"
json_export = false

[embedding]
model = "nomic-embed-text"
# Image embeddings need the optional embeddings-apple extra; onboarding
# installs it when you turn the option on.
image_embeddings = false
TOML
    chown "${CONSOLE_USER}" "${DATA_DIR}/config.toml"
fi

# Write the Chrome native messaging host manifest for every installed
# Chromium-family browser, so the extension works even if the app does not
# launch cleanly after install (the app rewrites them on launch anyway).
# The extension ID is derived from the SHA-256 of the RSA key in
# extension/manifest.json, mapped to Chrome's a-p alphabet.
NM_EXTENSION_ID="jpemkdcihaijkolbkankcldmiimmmnfo"
NM_MANIFEST='{
  "name": "com.agenthandover.host",
  "description": "AgentHandover native messaging host",
  "path": "'"${LIB_DIR}"'/ah-observer",
  "type": "stdio",
  "allowed_origins": [
    "chrome-extension://'"${NM_EXTENSION_ID}"'/"
  ]
}'
for browser_dir in \
    "Google/Chrome" \
    "Chromium" \
    "BraveSoftware/Brave-Browser" \
    "Microsoft Edge" \
    "Arc/User Data" \
    "Comet"; do
    BROWSER_ROOT="${USER_HOME}/Library/Application Support/${browser_dir}"
    if [ -d "${BROWSER_ROOT}" ]; then
        mkdir -p "${BROWSER_ROOT}/NativeMessagingHosts"
        echo "${NM_MANIFEST}" > "${BROWSER_ROOT}/NativeMessagingHosts/com.agenthandover.host.json"
        chown "${CONSOLE_USER}" "${BROWSER_ROOT}/NativeMessagingHosts/com.agenthandover.host.json"
    fi
done

# ----------------------------------------------------------------------
# Python worker environment. The worker does VLM annotation and Skill
# generation; without it AgentHandover cannot function, so every failure
# here is fatal and names the log.
# ----------------------------------------------------------------------

# Interpreters we accept, most preferred first. The installer runs as root
# with a minimal PATH, so we probe absolute paths. /usr/bin/python3 and
# `xcrun -f python3` are the Command Line Tools interpreter (3.9 on current
# macOS, so normally rejected); they are only probed when the tools are
# installed, because on a Mac without them the /usr/bin/python3 shim opens
# an install dialog instead of running. AH_PYTHON_CANDIDATES (space
# separated) replaces the list, for the install test harness.
python_candidates() {
    if [ -n "${AH_PYTHON_CANDIDATES:-}" ]; then
        echo "${AH_PYTHON_CANDIDATES}"
        return
    fi
    local _v
    for _v in 14 13 12 11; do echo "/opt/homebrew/bin/python3.${_v}"; done
    echo /opt/homebrew/bin/python3
    for _v in 14 13 12 11; do echo "/usr/local/bin/python3.${_v}"; done
    echo /usr/local/bin/python3
    for _v in 14 13 12 11; do echo "/Library/Frameworks/Python.framework/Versions/3.${_v}/bin/python3"; done
    if xcode-select -p >/dev/null 2>&1; then
        xcrun -f python3 2>/dev/null || true
        echo /usr/bin/python3
    fi
}

PY_CHECK='import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)'

find_python() {
    local _c
    for _c in $(python_candidates); do
        if [ -x "${_c}" ] && "${_c}" -c "${PY_CHECK}" >/dev/null 2>&1; then
            echo "${_c}"
            return 0
        fi
    done
    return 1
}

pip_failed() {
    echo "ERROR: $1" >&2
    echo "Full pip output: ${PIP_LOG}" >&2
    tail -n 20 "${PIP_LOG}" >&2 || true
    exit 1
}

WORKER_SPEC="${LIB_DIR}/worker[mcp,vlm-ollama]"

# Liveness probe on an existing venv: it must start and be new enough.
# A venv whose interpreter was removed (brew upgrade) or is too old is
# rebuilt from scratch rather than patched.
if [ -d "${VENV}" ] && ! as_user "${VENV}/bin/python" -c "${PY_CHECK}" >/dev/null 2>&1; then
    echo "  Existing Python environment is broken or too old; rebuilding it."
    rm -rf "${VENV}"
fi

if [ ! -d "${VENV}" ]; then
    if ! PYTHON3=$(find_python); then
        cat >&2 <<ERR
ERROR: AgentHandover needs Python 3.11 or later, and none was found.

Checked, in order:
$(python_candidates | sed 's/^/  /')

The Python that ships with the Command Line Tools (/usr/bin/python3) is 3.9,
which is too old. Install a current Python, then re-run the installer:
  brew install python@3.13
or download it from https://www.python.org/downloads/macos/
ERR
        exit 1
    fi
    echo "  Using Python: ${PYTHON3} ($("${PYTHON3}" -c 'import platform; print(platform.python_version())'))"

    # Only the venv belongs to the user (so the app can pip-install optional
    # extras later); everything else under LIB_DIR stays root-owned.
    mkdir -p "${VENV}"
    chown "${CONSOLE_USER}" "${VENV}"
    if ! as_user "${PYTHON3}" -m venv "${VENV}" >>"${PIP_LOG}" 2>&1; then
        rm -rf "${VENV}"
        pip_failed "could not create the Python virtual environment at ${VENV}."
    fi
    echo "  Installing worker package..."
    if ! as_user "${VENV}/bin/pip" install --disable-pip-version-check "${WORKER_SPEC}" >>"${PIP_LOG}" 2>&1; then
        rm -rf "${VENV}"
        pip_failed "could not install the AgentHandover worker package."
    fi
    echo "  Python virtual environment created."
else
    # Earlier installs may have left root-owned files in the venv, which
    # blocks pip from replacing them as the user.
    chown -R "${CONSOLE_USER}" "${VENV}"
    echo "  Updating worker package..."
    if ! as_user "${VENV}/bin/pip" install --disable-pip-version-check "${WORKER_SPEC}" >>"${PIP_LOG}" 2>&1; then
        pip_failed "could not update the AgentHandover worker package."
    fi
fi

# Ownership and permissions. The daemon binary holds Screen Recording and
# Accessibility, so nothing but the venv may be writable by the user.
# Re-asserted on every install so earlier installs that chowned the whole
# lib dir to the user are repaired.
if [ "${IS_ROOT}" -eq 1 ]; then
    find "${LIB_DIR}" -path "${VENV}" -prune -o -exec chown -h root:wheel {} +
    chown root:wheel "${BIN_DIR}/agenthandover"
fi
find "${LIB_DIR}" -path "${VENV}" -prune -o -exec chmod -h go-w {} +
chmod 755 "${LIB_DIR}" "${LIB_DIR}/ah-observer" "${BIN_DIR}/agenthandover"

# Symlink worker entry points into BIN_DIR so agents and the CLI find them.
for cmd in agenthandover-mcp agenthandover-connect agenthandover-worker; do
    if [ -x "${VENV}/bin/${cmd}" ]; then
        ln -sf "${VENV}/bin/${cmd}" "${BIN_DIR}/${cmd}"
    fi
done

if [ "${NO_SERVICES}" != "1" ]; then
    if [ "${IS_FRESH}" -eq 1 ]; then
        # Clear the stale pre-v0.2.1 daemon TCC identity so users only see
        # AgentHandover in System Settings. Fresh installs only: on an
        # upgrade this would needlessly re-prompt.
        as_user tccutil reset ScreenCapture com.agenthandover.daemon >/dev/null 2>&1 || true
        as_user tccutil reset Accessibility com.agenthandover.daemon >/dev/null 2>&1 || true
        as_user defaults write com.agenthandover.app hasCompletedOnboarding -bool false || warn "could not reset onboarding state"
    fi
    as_user launchctl disable "gui/${CONSOLE_UID}/com.agenthandover.daemon" 2>/dev/null || true
fi

# Chrome extension setup (informational only)
EXT_DIR="${LIB_DIR}/extension"
if [ -f "${EXT_DIR}/manifest.json" ] && [ -f "${EXT_DIR}/background.js" ]; then
    echo "Chrome extension pre-built and ready."
    echo "  Load it in Chrome: chrome://extensions -> Load unpacked -> ${EXT_DIR}"
elif [ -d "${EXT_DIR}/src" ]; then
    echo ""
    echo "Chrome extension source is included but not pre-built."
    echo "To build the extension:"
    echo "  cd ${EXT_DIR}"
    echo "  npm install && npm run build"
    echo "Then load in Chrome: chrome://extensions -> Load unpacked -> ${EXT_DIR}/dist"
else
    echo ""
    echo "Chrome extension not included in this package."
    echo "To install it from source:"
    echo "  git clone https://github.com/sandroandric/AgentHandover.git"
    echo "  cd AgentHandover/extension && npm install && npm run build"
    echo "Then load in Chrome: chrome://extensions -> Load unpacked -> extension/dist"
fi

if [ "${NO_SERVICES}" != "1" ]; then
    # Register the worker (RunAtLoad starts it now and at every login;
    # launchd restarts it if it exits with an error). preinstall booted
    # out the previous instance.
    if as_user launchctl bootstrap "gui/${CONSOLE_UID}" "${LAUNCH_AGENTS}/com.agenthandover.worker.plist"; then
        echo "  Worker service registered and started."
    else
        warn "launchctl could not register the worker; run 'agenthandover start worker'"
    fi

    # Launch the menu bar app (as the real user, not root). preinstall quit
    # the old one, so this starts the binary we just installed.
    if [ -d "${APP_PATH}" ]; then
        as_user open "${APP_PATH}" 2>/dev/null || warn "could not open ${APP_PATH}"
        echo "AgentHandover app launched: check your menu bar."
    fi
fi

# Mark that an install has completed (upgrade detection).
touch "${DATA_DIR}/config.toml.bak"
chown "${CONSOLE_USER}" "${DATA_DIR}/config.toml.bak"

echo ""
if [ -n "$WARNINGS" ]; then
    echo "AgentHandover installed with warnings:"
    echo -e "$WARNINGS"
    echo ""
    echo "Run 'agenthandover doctor' to diagnose issues."
else
    echo "AgentHandover installed successfully."
fi
exit 0
